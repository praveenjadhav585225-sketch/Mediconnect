# Copy to .env and fill in. .env is git-ignored, never commit it.

# PostgreSQL: the web app and Python scripts connect as the LIMITED role below
PGHOST=localhost
PGPORT=5432
PGDATABASE=mediconnect
PGUSER=mediconnect_app
PGPASSWORD=change_me_app_password

# PostgreSQL superuser: used ONLY when running migrations/seeds from psql, never by the app
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change_me_postgres_password

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mediconnect

# Embedding service
EMBEDDING_SERVICE_URL=http://localhost:8001
EMBEDDING_API_KEY=change_me_to_a_shared_local_service_key

# Auth: generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
